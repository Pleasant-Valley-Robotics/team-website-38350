---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getTeam } from '../team';

const team = await getTeam();
const t = team.data;
const { Content } = await render(team);
---

<Base>
  <section class="team-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{t.program} Team #{t.number}{t.founded && ` · Since ${t.founded}`}</span>
        <h1>{t.name}</h1>
        <p class="tagline">{t.tagline}</p>
        {t.highlights.length > 0 && (
          <ul class="chips">
            {t.highlights.map((h) => <li>{h}</li>)}
          </ul>
        )}
      </div>
      <div class="logo" style={`background: ${t.logoBg}`}><img src={t.logo} alt={`${t.name} logo`} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container story">
      <div class="prose"><Content /></div>
      <aside class="card connect">
        <h3>Connect with {t.shortName}</h3>
        {t.email && <p><a href={`mailto:${t.email}`}>{t.email}</a></p>}
        {!t.email && t.socials.length === 0 && <p class="muted">Coming soon.</p>}
        <ul>
          {t.socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </aside>
    </div>
    {t.photo && (
      <div class="container">
        <figure class="photo">
          <img src={t.photo} alt={t.photoAlt ?? ''} loading="lazy" />
          {t.photoAlt && <figcaption class="muted">{t.photoAlt}</figcaption>}
        </figure>
      </div>
    )}
  </section>

  {t.sections.map((s) => (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head"><span class="eyebrow">How we work</span><h2>{s.title}</h2></div>
        <div class="grid grid--3">
          {s.items.map((i) => (
            <div class="card item"><h3>{i.title}</h3><p class="muted">{i.body}</p></div>
          ))}
        </div>
      </div>
    </section>
  ))}

  {t.outreach.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Outreach</span>
          <h2>In the community</h2>
          <p class="lede">Some of the ways {t.shortName} shares STEM beyond the competition field.</p>
        </div>
        <div class="grid grid--3">
          {t.outreach.map((o) => (
            <div class="card item"><h3>{o.title}</h3><p class="muted">{o.body}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .team-hero {
    padding-block: clamp(56px, 9vw, 110px) clamp(48px, 7vw, 80px);
    background:
      radial-gradient(700px 380px at 0% 0%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 70%),
      radial-gradient(520px 320px at 100% 20%, rgb(139 92 246 / 0.25), transparent 70%);
  }
  .team-hero .eyebrow { color: var(--accent); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .tagline { font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--muted); max-width: 46ch; }
  .chips { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { border: 1px solid var(--border); background: rgb(255 255 255 / 0.04); border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.9rem; }
  .logo { border-radius: 24px; padding: clamp(1.5rem, 4vw, 2.5rem); display: flex; align-items: center; justify-content: center; max-width: 420px; justify-self: center; width: 100%; height: 300px; }
  .logo img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .story { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .story { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; } }
  .prose { font-size: 1.15rem; max-width: 68ch; }
  .connect ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .connect li a { display: inline-block; border: 1px solid var(--border); border-radius: 999px; padding: 0.3rem 0.85rem; text-decoration: none; }
  .connect p { overflow-wrap: anywhere; }

  .photo { margin: 3rem 0 0; }
  .photo img { border-radius: var(--radius); width: 100%; }
  .photo figcaption { margin-top: 0.75rem; font-size: 0.9rem; }

  .item { border-top: 3px solid var(--accent); }
  .item p { margin-bottom: 0; }
</style>
