@*
    The frame around every page: the <head>, the menu at the top and the footer.
    Each page's own content appears where @RenderBody() is.
*@
@{
    var team = TeamInfo.Team;
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle is null ? $"{team.Name} | {team.Program} #{team.Number}" : $"{pageTitle} | {team.Name}";
    var description = ViewData["Description"] as string
        ?? $"{team.Program} Team #{team.Number} {team.Name} at Pleasant Valley High School. {team.Tagline}";
    var currentPath = Context.Request.Path.Value?.TrimEnd('/') is { Length: > 0 } p ? p : "/";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <link rel="icon" href="@team.Logo" />
    <meta name="theme-color" content="#070b1f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="--accent: @team.AccentColor">
    <a class="skip" href="#main">Skip to content</a>

    <header class="header">
        <div class="container bar">
            <a class="brand" href="/">
                <img src="@team.Logo" alt="" width="40" height="40" style="background: @team.LogoBackground" />
                <span>@team.Name</span>
            </a>
            <nav aria-label="Main">
                <ul>
                    @foreach (var link in TeamInfo.Nav)
                    {
                        <li><a href="@link.Href" aria-current="@(currentPath == link.Href ? "page" : null)">@link.Label</a></li>
                    }
                    <li><a href="@TeamInfo.PvSite">PV Robotics ↗</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <a class="pv" href="@TeamInfo.PvSite">
                <img src="/images/pv-logo.png" alt="" width="44" height="44" />
                <span>Part of Pleasant Valley FIRST Robotics</span>
            </a>
            <img class="footer-first" src="/images/first-logo.png" alt="FIRST" width="111" height="70" />
        </div>
        <div class="container legal muted">© @DateTime.Now.Year @team.Name · @team.Program Team #@team.Number</div>
    </footer>
</body>
</html>
