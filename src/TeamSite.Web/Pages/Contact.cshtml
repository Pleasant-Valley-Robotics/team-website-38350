@page
@{
    ViewData["Title"] = "Contact";
}
@*
    The contact page: /contact
    The team's email is the team's shared account. Never put a student's personal email here.
*@

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Contact</span>
