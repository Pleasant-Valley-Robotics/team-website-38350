            <p><a href="mailto:FTC38350@gmail.com">FTC38350@gmail.com</a></p>
        </div>
        <div class="card item connect">
            <h2 class="h3">Instagram</h2>
            <p><a href="https://www.instagram.com/prime_suspects_38350/" rel="noopener" target="_blank">@@prime_suspects_38350</a></p>
        </div>
        <div class="card item connect">
            <h2 class="h3">TikTok</h2>
            <p><a href="https://www.tiktok.com/@@prime.suspects5" rel="noopener" target="_blank">@@prime.suspects5</a></p>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container grid grid--2">
        <div class="card">
