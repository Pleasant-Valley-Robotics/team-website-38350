@*
    The frame around every page: the browser tab's title, the menu at the top and
    the footer at the bottom. Each page's own words appear where @RenderBody() is.
*@
@{
    // Which page is open, so the menu can light up its link.
    var here = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    string? Current(string href) => here == href.TrimEnd('/') ? "page" : null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The words in the browser tab: the page's own title, then your team's name. -->
    <title>@ViewData["Title"] | Prime Suspects</title>
    <!-- What search engines and link previews say about your site. -->
    <meta name="description" content="FTC Team #38350 Prime Suspects at Pleasant Valley High School. Pleasant Valley&#x27;s newest FTC team, on the case." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Prime Suspects | FTC Team #38350" />
    <meta property="og:description" content="FTC Team #38350 Prime Suspects at Pleasant Valley High School. Pleasant Valley&#x27;s newest FTC team, on the case." />
    <meta name="theme-color" content="#070b1f" />
    <!-- The little picture in the browser tab: your team's logo. -->
    <link rel="icon" href="/images/prime-suspects-logo.jpg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<!-- --accent is your team's color, used for borders and highlights. -->
<body style="--accent: #3b82f6">
    <a class="skip" href="#main">Skip to content</a>

    <header class="header">
        <div class="container bar">
            <a class="brand" href="/">
                <!-- Your team's logo (put the file in wwwroot/images/). Use #000000 for logos drawn on black. -->
                <img src="/images/prime-suspects-logo.jpg" alt="" width="40" height="40" style="background: #000000" />
                <span>Prime Suspects <small>#38350</small></span>
            </a>
            <!-- The menu. To add a page to it, copy one <li> line and change the address (twice) and the words. -->
            <nav aria-label="Main">
                <ul>
                    <li><a href="/" aria-current="@Current("/")">Home</a></li>
                    <li><a href="/news" aria-current="@Current("/news")">News</a></li>
                    <li><a href="/season" aria-current="@Current("/season")">2026–27 Season</a></li>
                    <li><a href="/team" aria-current="@Current("/team")">Meet the Team</a></li>
                    <li><a href="/calendar" aria-current="@Current("/calendar")">Calendar</a></li>
                    <li><a href="/sponsors" aria-current="@Current("/sponsors")">Sponsors</a></li>
                    <li><a href="/thank-you" aria-current="@Current("/thank-you")">Thank You</a></li>
                    <li><a href="/contact" aria-current="@Current("/contact")" class="nav-cta">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <a class="brand" href="/">
                    <img src="/images/prime-suspects-logo.jpg" alt="" width="40" height="40" style="background: #000000" />
                    <span>Prime Suspects</span>
                </a>
                <p class="muted footer-blurb"><em>FIRST</em> Tech Challenge Team #38350 at Pleasant Valley High School.</p>
            </div>
            <div>
                <h3 class="footer-head">Follow us</h3>
                <!-- The team's accounts. The same links are on the home page and the Contact page. -->
                <ul class="footer-links">
                    <li><a href="https://www.instagram.com/prime_suspects_38350/" rel="noopener" target="_blank">Instagram</a></li>
                    <li><a href="https://www.tiktok.com/@@prime.suspects5" rel="noopener" target="_blank">TikTok</a></li>
                    <li><a href="mailto:FTC38350@gmail.com">FTC38350@gmail.com</a></li>
                </ul>
            </div>
            <div>
                <h3 class="footer-head">Get involved</h3>
                <ul class="footer-links">
                    <li><a href="/sponsors">Sponsor the team</a></li>
                    <li><a href="/contact">Contact us</a></li>
                    <li><a href="/thank-you">Thank you</a></li>
                </ul>
            </div>
            <div class="footer-logos">
                <a class="pv" href="https://www.firstpvrobotics.com">
                    <img src="/images/pv-logo.png" alt="" width="44" height="44" />
                    <span>Part of Pleasant Valley <em>FIRST</em> Robotics</span>
                </a>
                <img class="footer-first" src="/images/first-logo.png" alt="FIRST" width="111" height="70" />
            </div>
        </div>
        <!-- The year fills itself in. -->
        <div class="container legal muted">© @DateTime.Now.Year Prime Suspects · FTC Team #38350</div>
    </footer>
</body>
</html>
