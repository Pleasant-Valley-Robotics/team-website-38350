@page
@{
    ViewData["Title"] = "Home";
}
@*
    The home page: https://38350.firstpvrobotics.com/
    Everything below is plain HTML. Change the words between the tags.
    The notes in <!-- --> tell you what goes where; visitors don't see them.
*@

<section class="team-hero">
    <div class="container hero-grid">
        <div>
            <!-- FTC or FRC, your team number, and the year you started. -->
            <span class="eyebrow">FTC Team #38350</span>
            <!-- Your team's name. -->
            <h1>Prime Suspects</h1>
            <!-- One sentence about what your team is about. -->
            <p class="tagline">Pleasant Valley's newest FTC team, on the case.</p>
        </div>
        <!-- Your logo, in wwwroot/images/. Use background: #000000 for logos drawn on black. -->
        <div class="hero-logo" style="background: #000000">
            <img src="/images/prime-suspects-logo.jpg" alt="Prime Suspects logo" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container story">
        <!-- Your team's story. One <p> per paragraph. -->
        <div class="prose">
            <p>Prime Suspects is FTC Team #38350, the newest FIRST Tech Challenge team at Pleasant Valley High School. Like our other teams, Prime Suspects students design, build and program a competition robot while learning teamwork, problem solving and communication along the way.</p>
            <p>More about the team, its members' goals and its outreach is coming soon.</p>
        </div>
        <aside class="card connect">
            <h3>Connect with Prime Suspects</h3>
            <!-- Replace this with your email address and account links when you have them. -->
            <p class="muted">Coming soon.</p>
        </aside>
    </div>
</section>
