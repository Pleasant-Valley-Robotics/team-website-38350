@page "/thank-you"
@{
    ViewData["Title"] = "Thank You";
}
@*
    The thank-you page: /thank-you
    Thank the people who help the team. Copy one <div class="card item"> block to add another.
*@

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Thank You</span>
        <h1>We couldn't do it without you</h1>
        <p class="lede">A robotics team takes a whole community. Thank you to everyone who helps Prime Suspects build, compete and grow.</p>
    </div>
</section>

<section class="section">
    <div class="container grid grid--2">
        <div class="card item">
            <h2 class="h3">Our sponsors</h2>
            <p class="muted">For the parts, tools, registrations and travel that put a robot on the field. See them all on the <a href="/sponsors">sponsors page</a>.</p>
        </div>
        <div class="card item">
            <h2 class="h3">Our coaches and mentors</h2>
            <p class="muted">For the evenings and weekends spent teaching, guiding and keeping the team on track.</p>
        </div>
        <div class="card item">
            <h2 class="h3">Our families</h2>
            <p class="muted">For the rides, the snacks, the cheering in the stands and the patience at home.</p>
        </div>
        <div class="card item">
            <h2 class="h3">Pleasant Valley High School</h2>
            <p class="muted">For giving us a place to build and supporting robotics at our school.</p>
        </div>
        <div class="card item">
            <h2 class="h3">Pleasant Valley <em>FIRST</em> Robotics</h2>
            <p class="muted">For bringing the program's teams together and helping a new team get started.</p>
        </div>
        <div class="card item">
            <h2 class="h3"><em>FIRST</em> and its volunteers</h2>
            <p class="muted">For the events, referees, judges and volunteers who make every competition happen.</p>
        </div>
    </div>
</section>
