@page
@{
    ViewData["Title"] = "2026–27 Season";
}
@*
    The season page: /season
    Fill in this year's game, the robot and the team's goals.
*@

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">2026–2027 Season</span>
        <h1>This season</h1>
        <p class="lede">What we're building, what we're aiming for and where we're competing in the 2026–2027 <em>FIRST</em> Tech Challenge season.</p>
    </div>
</section>

<section class="section">
    <div class="container grid grid--2">
        <div class="card item">
            <h2 class="h3">The game</h2>
            <!-- Describe this season's game: what robots have to do to score. -->
            <p class="muted">Every year <em>FIRST</em> releases a new game with new challenges for robots to solve. A description of this season's game is coming soon.</p>
            <p><a href="https://www.firstinspires.org/robotics/ftc" rel="noopener" target="_blank">About <em>FIRST</em> Tech Challenge ↗</a></p>
        </div>
        <div class="card item">
            <h2 class="h3">Our robot</h2>
            <!-- Describe your robot: its name, how it scores, what you're proud of. Add a photo with <img src="/images/robot.jpg" alt="Our robot" />. -->
            <p class="muted">Our robot is in the works. Photos and details are coming soon.</p>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Goals</span>
            <h2>What we're aiming for</h2>
        </div>
        <!-- Your team's goals for the season. Copy one <div class="card"> block to add another. -->
        <div class="grid grid--3">
            <div class="card">
                <span class="step">01</span>
                <h3>Build and compete</h3>
                <p class="muted">Design, build and program a robot, then take it to competition.</p>
            </div>
            <div class="card">
                <span class="step">02</span>
                <h3>Learn together</h3>
                <p class="muted">Grow our skills in engineering, programming and teamwork.</p>
            </div>
            <div class="card">
                <span class="step">03</span>
                <h3>Share STEM</h3>
                <p class="muted">Bring robotics to our school and community through outreach.</p>
            </div>
        </div>
        <p class="more">Competition dates are on the <a href="/calendar">calendar</a>.</p>
    </div>
</section>
